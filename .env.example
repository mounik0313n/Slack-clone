# Core application
APP_ENV=development
APP_NAME=slack-platform
APP_DOMAIN=localhost
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-to-a-long-random-key-123456
JWT_SECRET_KEY=change-this-jwt-secret-to-a-long-random-key-1234567890
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/slack_platform
POSTGRES_DB=slack_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://:redis_password@localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# NATS
NATS_URL=nats://localhost:4222
NATS_STREAMS=DOMAIN_EVENTS,REALTIME,SEARCH,NOTIFICATIONS,FILES,WORKFLOWS,ANALYTICS,AI

# OpenSearch
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PUBLIC_URL=http://localhost:9000

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8001

# LiveKit
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=slack-platform
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_PASSWORD=admin
LOKI_URL=http://localhost:3100

# AI
AI_DEFAULT_PROVIDER=openai-compatible
AI_OPENAI_API_KEY=replace-me
AI_OPENAI_BASE_URL=https://api.example.com/v1

# Security
RATE_LIMIT_PER_MINUTE=120
PASSWORD_HASH_ALGORITHM=argon2id

# Docker
COMPOSE_PROJECT_NAME=slack-platform
