# Production environment example
APP_ENV=production
APP_NAME=slack-platform
APP_DOMAIN=app.example.com
LOG_LEVEL=INFO
SECRET_KEY=replace_with_a_secure_random_64_char_secret
JWT_SECRET_KEY=replace_with_another_secure_random_64_char_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=https://app.example.com,https://www.example.com

DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@db.example.com:5432/slack_platform
POSTGRES_DB=slack_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_DB_PASSWORD
POSTGRES_HOST=db.example.com
POSTGRES_PORT=5432

REDIS_URL=redis://:YOUR_REDIS_PASSWORD@redis.example.com:6379/0
REDIS_HOST=redis.example.com
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD

NATS_URL=nats://nats.example.com:4222
NATS_STREAMS=DOMAIN_EVENTS,REALTIME,SEARCH,NOTIFICATIONS,FILES,WORKFLOWS,ANALYTICS,AI

OPENSEARCH_URL=https://search.example.com:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=YOUR_SEARCH_PASSWORD

MINIO_ENDPOINT=storage.example.com:9000
MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=YOUR_MINIO_PASSWORD
MINIO_PUBLIC_URL=https://storage.example.com

VITE_API_URL=https://api.example.com
VITE_WS_URL=wss://api.example.com/ws

LIVEKIT_URL=wss://meet.example.com
LIVEKIT_API_KEY=your_livekit_key
LIVEKIT_API_SECRET=your_livekit_secret

OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com:4318
OTEL_SERVICE_NAME=slack-platform
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_PASSWORD=YOUR_GRAFANA_PASSWORD
LOKI_URL=https://logs.example.com

AI_DEFAULT_PROVIDER=openai-compatible
AI_OPENAI_API_KEY=YOUR_OPENAI_KEY
AI_OPENAI_BASE_URL=https://api.openai.com/v1

RATE_LIMIT_PER_MINUTE=120
PASSWORD_HASH_ALGORITHM=argon2id
